@using StubSite.Data
@using StubSite.Repo
@inject NavigationManager NavMan

@inject IJSRuntime JSRuntime
@implements IDisposable

<nav class="navbar navbar-expand-md navbar-dark bg-dark top-bar fade-in border-while-open navbar-grow flex-c-start sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand bcg-brand" href="">
            <img alt="Logo image" src="images/CompanyLogo.jpg" />
        </a>
        <h2 class="navbar-toggler @NavButtonCssClass" style="transform:translateX(-.5em);border:none;font-size:xx-large;color:white">@Constants.CurPage</h2>
        <ToggleMenu OnToggle="ToggleNavMenu" />
        <div class="collapse navbar-collapse  fade-in-delay @NavBarCssClass" id="navbarCollapse" @onclick="ToggleNavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi" aria-hidden="true"></span> Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="services">
                        <span class="oi oi-plus" aria-hidden="true"></span> Services
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="contact-us">
                        <span class="oi" aria-hidden="true"></span> Contact Us
                    </NavLink>
                </li>
            </ul>
        </div>
    </div>
    <a href="https://book.squareup.com/appointments/p9mg1leagi1dhw/location/LJ4Y9FNPTJNXV/services" target="_blank"
       rel="noopener noreferrer"
       class="bcg-button bcg-button-small hide-in-mobile">
        BOOK NOW <span>↗</span>
    </a>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? NavBarCssClass => collapseNavMenu ? null : "show";
    private string? NavButtonCssClass => collapseNavMenu ? "collapsed" : null;

    List<string> Categories = new List<string>();

    string selCat { get; set; }
    string SelCat
    {
        get { return selCat; }
        set
        {
            if (string.IsNullOrEmpty(value))
                return;

            selCat = value;
            JumpToSection(selCat);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Constants.CurPageChanged += CurPageUpdated;

        Dictionary<string, List<Item>> Items = await MenuRepo.GetMenuItemsAsDictionary();
        Categories = Items.Keys.ToList();
    }
    private async void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CurPageUpdated(object sender, string cp)
    {
        StateHasChanged();
    }

    private async Task JumpToSection(string id)
    {
        await JSRuntime.InvokeVoidAsync("scrollToFragment", id);
    }

    public void Dispose()
    {
        Constants.CurPageChanged -= CurPageUpdated;
    }
}
