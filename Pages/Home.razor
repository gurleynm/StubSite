@page "/"
@using StubSite.Shared.Specific
@inject NavigationManager NavMan

<PageTitle>Loveland Yoga</PageTitle>

<div style="overflow-x: hidden;">
    <!-- HERO -->
    <section class="hero-section"
             style="background-image:url('https://images.unsplash.com/photo-1506126613408-eca07ce68773')">

        <div class="hero-overlay"></div>

        <div class="hero-content container">
            <div class="hero-subtitle">
                Private Yoga Instruction
            </div>

            <h1 class="hero-title">
                @Constants.CompanyName
            </h1>

            <p class="hero-description">
                Personalized yoga instruction for individuals and small groups. Book sessions at partner locations or enjoy private instruction in the comfort of your home.
            </p>

            <div class="hero-buttons">
                <button class="btn btn-primary custom-btn" @onclick=@(() => NavMan.NavigateTo("booking"))>
                    Book a Session
                </button>

                <button class="btn btn-outline-light custom-btn" @onclick=@(() => NavMan.NavigateTo("#visit"))>
                    Visit
                </button>
            </div>
        </div>
    </section>

    <!-- THE SPACE -->
    <section class="section-padding" id="space">
        <div class="container">
            <div class="flex-c-start" style="width:100%">
                <div>
                    <div class="section-label">
                        THE EXPERIENCE
                    </div>

                    <h2 class="section-title">
                        Find balance,
                        strength &
                        confidence.
                    </h2>

                    <p class="section-text">
                        Personalized yoga instruction for individuals and small groups. Book sessions at partner locations or enjoy private instruction in the comfort of your home.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Meet Your Instructor -->
    <section class="section-padding" id="instructor">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="section-label">
                        Meet Your Instructor
                    </div>

                    <h2 class="section-title">
                        Hi, I'm Anna.
                    </h2>

                    <p class="section-text">
                        With over 10 years of yoga experience and certified instruction, my goal is to help students build strength, improve mobility, and create sustainable wellness habits through personalized practice.
                    </p>

                    <div class="feature-row">
                        <div>
                            <div class="feature-number">
                                Certified
                            </div>

                            <div class="feature-text">
                                200 YTT Certified
                            </div>
                        </div>

                        <div>
                            <div class="feature-number">
                                Vinyasa Style
                            </div>

                            <div class="feature-text">
                                Focus Present Practice Yoga
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="gallery-grid">
                        <img src="/images/insta.jpg"
                             class="gallery-img tall" />

                        <img src="https://static.wixstatic.com/media/9ebef2_07165e272a8e40b4961e0417a6aab60c~mv2.jpeg/v1/crop/x_0,y_424,w_1242,h_1360/fill/w_582,h_638,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/image0.jpeg"
                             class="gallery-img tall offset-img" />

                        @* <img src="https://static.wixstatic.com/media/9ebef2_07165e272a8e40b4961e0417a6aab60c~mv2.jpeg/v1/crop/x_0,y_424,w_1242,h_1360/fill/w_582,h_638,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/image0.jpeg"
                             class="gallery-img wide" /> *@
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- VISIT -->

    <section class="section-padding" id="visit">
        <div class="container">
            <div class="row g-5 align-items-center">

                <div class="col-lg-6">
                    <div class="section-label">
                        VISIT ME
                    </div>
                    <h2 class="section-title">
                        Start your journey with me.
                    </h2>

                    <hr style="width:100%;opacity:1;background-color:@Accent" />

                    <div class="visit-block">
                        <h3><span class="oi oi-map-marker" /> Flexible Locations</h3>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="flex-r" style="align-items:center;flex-wrap:wrap">
                        <div class="flex-c-start" style="align-items:center;margin:1em">
                            <h3>Loveland</h3>
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3088.9603346662743!2d-84.26279232404536!3d39.266466571647655!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8840f8adece5d769%3A0xbce75d716f01c53!2sLoveland%20Paddlesports!5e0!3m2!1sen!2sus!4v1780338715773!5m2!1sen!2sus"
                                    class="map-iframe" style="height:100%;width:80%;border-radius: 2rem;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                        <div class="flex-c-start" style="align-items:center">
                            <h3>Milford</h3>
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3081.6020202605705!2d-84.20771169999999!3d39.4331231!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8840f4228987bf1f%3A0x31bdfa0e267a1145!2s9%20E%20Main%20St%2C%20Lebanon%2C%20OH%2045036!5e0!3m2!1sen!2sus!4v1780084882864!5m2!1sen!2su"
                                    class="map-iframe" style="height:100%;width:80%;border-radius: 2rem;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SOCIAL -->
    <section class="social-section">
        <div class="container text-center">

            <div class="flex-r-100">
                <div class="section-label social-label">
                    FOLLOW ALONG
                </div>
            </div>

            <h2 class="social-title">
                @@abersani
            </h2>

            <p class="social-text">
                Flexible options designed around your schedule and goals.
            </p>

            <div class="flex-r-100-wrap">
                @foreach (string key in Constants.CompanySocials.Keys)
                {
                    <button class="custom-btn social-btn" @onclick=@(() => NavMan.NavigateTo(Constants.CompanySocials[key]))>
                        Visit @key
                    </button>
                }
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter(Name = "Main")]
    public string Main { get; set; }

    [CascadingParameter(Name = "Accent")]
    public string Accent { get; set; }

    [CascadingParameter(Name = "Text")]
    public string Text { get; set; }

    [CascadingParameter(Name = "ButtonText")]
    public string ButtonText { get; set; }

    protected override Task OnInitializedAsync()
    {
        Constants.CurPage = "Home";
        return base.OnInitializedAsync();
    }

    public class DrinkItem
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string ImgSrc { get; set; } = "";
    }
}