@page "/"
@using System

<PageTitle>Blue Collar Grooming | Williamsburg, Ohio</PageTitle>

<div class="bcg-site">

    <main>
        <!-- Hero -->
        <section class="bcg-hero" id="home">
            <div class="bcg-hero-overlay"></div>

            <div class="bcg-container bcg-hero-content">
                <div class="bcg-eyebrow">
                    <span></span> WILLIAMSBURG, OHIO
                </div>

                <h1>
                    LOOK SHARP.<br />
                    <span>STAY GROUNDED.</span>
                </h1>

                <p class="bcg-hero-tagline">
                    @Info("Tagline", "Good People. Good Cuts.")
                </p>

                <p class="bcg-hero-description">
                    Quality grooming. Attention to detail.
                    No nonsense. Just a great cut and an even
                    better experience.
                </p>

                <div class="bcg-hero-actions">
                    <a href="@BookingUrl" target="_blank"
                       rel="noopener noreferrer"
                       class="bcg-button">
                        BOOK YOUR APPOINTMENT <span>↗</span>
                    </a>
                    <a href="#services" class="bcg-button-outline">
                        EXPLORE SERVICES
                    </a>
                </div>

                <div class="bcg-hero-note">
                    <span class="bcg-note-line"></span>
                    INDEPENDENT GROOMING. PERSONAL SERVICE.
                </div>
            </div>

            <div class="bcg-hero-bottom">
                <span>ESTABLISHED ON QUALITY</span>
                <span>BUILT FOR THE EVERYDAY GUY</span>
            </div>
        </section>

        <!-- Quick information -->
        <section class="bcg-info-strip">
            <div class="bcg-container bcg-info-grid">
                <div class="bcg-info-item">
                    <span class="bcg-info-icon">✂</span>
                    <div>
                        <strong>QUALITY CUTS</strong>
                        <small>Attention to every detail</small>
                    </div>
                </div>

                <div class="bcg-info-item">
                    <span class="bcg-info-icon">◷</span>
                    <div>
                        <strong>EASY BOOKING</strong>
                        <small>Schedule online with Square</small>
                    </div>
                </div>

                <div class="bcg-info-item">
                    <span class="bcg-info-icon">⌖</span>
                    <div>
                        <strong>LOCAL BUSINESS</strong>
                        <small>Williamsburg, Ohio</small>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services -->
        <section class="bcg-section bcg-services" id="services">
            <div class="bcg-container">
                <div class="bcg-section-heading">
                    <div class="bcg-eyebrow">
                        <span></span> WHAT WE DO
                    </div>
                    <h2>THE RIGHT CUT.<br /><span>EVERY TIME.</span></h2>
                    <p>
                        Straightforward services, quality results,
                        and a fresh look you'll feel good about.
                    </p>
                </div>

                <div class="bcg-service-grid">
                    @foreach (var service in Services)
                    {
                        <article class="bcg-service-card">
                            <div class="bcg-service-number">
                                @service.Number
                            </div>

                            <div class="bcg-service-divider"></div>

                            <h3>@Info(service.NameKey, service.DefaultName)</h3>

                            <p>
                                @Info(service.DescriptionKey,
                                service.DefaultDescription)
                        </p>

                        <div class="bcg-service-bottom">
                            <div class="bcg-price">
                                <small>PRICE</small>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(
                                                                        Info(service.PriceKey))
                                                                        ? "See Square"
                                                                        : Info(service.PriceKey))
                                </strong>
                            </div>

                                <a href="@BookingUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="@($"Book {Info(service.NameKey, service.DefaultName)}")"
                                   class="bcg-service-link">
                                    BOOK <span>↗</span>
                                </a>
                            </div>
                        </article>
                                        }
                </div>

                <div class="bcg-services-footer">
                    <p>
                        Looking for something specific?
                        View the complete service menu and available
                        appointment times through Square.
                    </p>
                    <a href="@BookingUrl" target="_blank"
                       rel="noopener noreferrer"
                       class="bcg-text-link">
                        VIEW FULL SERVICE MENU ↗
                    </a>
                </div>
            </div>
        </section>

        <!-- About -->
        <section class="bcg-about" id="about">
            <div class="bcg-about-image">
                <div class="bcg-image-label">
                    <span>BLUE COLLAR</span>
                    <small>GROOMING LLC</small>
                </div>
            </div>

            <div class="bcg-about-content">
                <div class="bcg-eyebrow">
                    <span></span> A LITTLE ABOUT US
                </div>

                <h2>MORE THAN<br />JUST A <span>HAIRCUT.</span></h2>

                <p>
                    @Info("About",
                    "Quality service, attention to detail, and a great experience. That's what Blue Collar Grooming is all about.")
                </p>

                <p>
                    Whether it's your regular cleanup or your first
                    visit, the goal is simple: make sure you leave
                    looking your best.
                </p>

                <a href="@BookingUrl" target="_blank"
                   rel="noopener noreferrer"
                   class="bcg-button">
                    COME SEE US <span>↗</span>
                </a>
            </div>
        </section>

        <!-- Gallery -->
        @if (GalleryImages.Any(x => !string.IsNullOrWhiteSpace(x)))
        {
            <section class="bcg-section bcg-gallery" id="gallery">
                <div class="bcg-container">
                    <div class="bcg-section-heading bcg-centered">
                        <div class="bcg-eyebrow">
                            <span></span> THE FINISHED PRODUCT
                        </div>
                        <h2>FRESH CUTS.<br /><span>REAL RESULTS.</span></h2>
                        <p>
                            A look at the work, the details, and
                            the difference a good cut makes.
                        </p>
                    </div>

                    <div class="bcg-gallery-grid">
                        @foreach (var image in GalleryImages
                                            .Where(x => !string.IsNullOrWhiteSpace(x)))
                        {
                            <div class="bcg-gallery-image">
                                <img src="@image" alt="Blue Collar Grooming haircut portfolio" />
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Booking CTA -->
        <section class="bcg-booking">
            <div class="bcg-container bcg-booking-content">
                <div class="bcg-eyebrow">
                    <span></span> YOUR NEXT CUT STARTS HERE
                </div>

                <h2>READY FOR A<br /><span>CLEANUP?</span></h2>

                <p>
                    No phone tag. No unnecessary hassle.
                    Find a time that works and book your next
                    appointment online.
                </p>

                <a href="@BookingUrl" target="_blank"
                   rel="noopener noreferrer"
                   class="bcg-button bcg-button-light">
                    BOOK YOUR APPOINTMENT <span>↗</span>
                </a>

                <small>ONLINE SCHEDULING POWERED BY SQUARE</small>
            </div>
        </section>

        <!-- Location -->
        <section class="bcg-section bcg-location" id="location">
            <div class="bcg-container bcg-location-grid">
                <div>
                    <div class="bcg-eyebrow">
                        <span></span> COME ON IN
                    </div>

                    <h2>FIND <span>US.</span></h2>

                    <p class="bcg-location-name">
                        BLUE COLLAR GROOMING LLC
                    </p>

                    <address>
                        @AddressLine1<br />
                        @AddressLine2
                    </address>

                    @if (!string.IsNullOrWhiteSpace(Info("Phone")))
                    {
                        <p class="bcg-contact-line">
                            <strong>PHONE</strong>
                            <a href="@($"tel:{Info("Phone")}")">
                                @Info("Phone")
                            </a>
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Info("Email")))
                    {
                        <p class="bcg-contact-line">
                            <strong>EMAIL</strong>
                            <a href="@($"mailto:{Info("Email")}")">
                                @Info("Email")
                            </a>
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Info("Hours")))
                    {
                        <p class="bcg-contact-line">
                            <strong>HOURS</strong>
                            <span>@Info("Hours")</span>
                        </p>
                    }

                    <a href="@MapsUrl" target="_blank"
                       rel="noopener noreferrer"
                       class="bcg-button">
                        GET DIRECTIONS <span>↗</span>
                    </a>
                </div>

                <div class="bcg-map">
                    <iframe src="@MapEmbedUrl"
                            title="Blue Collar Grooming location map"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen>
                    </iframe>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bcg-footer">
        <div class="bcg-container">
            <div class="bcg-footer-top">
                <a href="#home" class="bcg-brand">
                    <img src="@Info("Logo")"
                         alt="Blue Collar Grooming Logo" />
                    <div class="bcg-brand-text">
                        <span>BLUE COLLAR</span>
                        <small>GROOMING CO.</small>
                    </div>
                </a>

                <div class="bcg-footer-links">
                    <a href="#services">SERVICES</a>
                    <a href="#about">ABOUT</a>
                    <a href="#location">LOCATION</a>
                    <a href="@BookingUrl" target="_blank"
                       rel="noopener noreferrer">BOOK ONLINE ↗</a>
                </div>
            </div>

            <div class="bcg-footer-bottom">
                <span>© @DateTime.Now.Year BLUE COLLAR GROOMING LLC</span>
                <span>GOOD PEOPLE. GOOD CUTS.</span>
            </div>
        </div>
    </footer>

    <!-- Mobile sticky booking button -->
    <div class="bcg-mobile-booking">
        <a href="@BookingUrl" target="_blank"
           rel="noopener noreferrer">
            BOOK YOUR APPOINTMENT ↗
        </a>
    </div>
</div>

@code {
    private string Info(string key, string fallback = "")
    {
        return Constants.CompanyInfo.TryGetValue(key, out var value)
            && !string.IsNullOrWhiteSpace(value)
                ? value
                : fallback;
    }

    private string BookingUrl =>
        Info("BookingUrl",
            "https://book.squareup.com/appointments/p9mg1leagi1dhw/location/LJ4Y9FNPTJNXV/services");

    private string AddressLine1 => Info("Address");

    private string AddressLine2 =>
        $"{Info("City")}, {Info("State")} {Info("Zip")}".Trim();

    private string FullAddress =>
        $"{AddressLine1}, {AddressLine2}";

    private string MapsUrl =>
        $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(FullAddress)}";

    private string MapEmbedUrl =>
        $"https://maps.google.com/maps?q={Uri.EscapeDataString(FullAddress)}&output=embed";

    private string[] GalleryImages =>
    [
        Info("GalleryImage1"),
        Info("GalleryImage2"),
        Info("GalleryImage3"),
        Info("GalleryImage4")
    ];

    private record ServiceCard(
        string Number,
        string NameKey,
        string DescriptionKey,
        string PriceKey,
        string DefaultName,
        string DefaultDescription);

    private List<ServiceCard> Services =>
    [
        new("01", "Service1Name", "Service1Description",
            "Service1Price", "Haircut",
            "A fresh, personalized haircut with attention to detail."),

        new("02", "Service2Name", "Service2Description",
            "Service2Price", "Beard Trim",
            "Clean shaping, crisp lines, and a polished finish."),

        new("03", "Service3Name", "Service3Description",
            "Service3Price", "Haircut & Beard",
            "The complete cleanup with a fresh cut and beard trim.")
    ];
}
