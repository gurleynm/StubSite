@page "/"
@using StubSite.Shared.Specific
@inject NavigationManager NavMan

<PageTitle>LOT No 1</PageTitle>

<div style="overflow-x: hidden;">
    <!-- HERO -->
    <section class="hero-section"
             style="background-image:url('/images/Background.png')">

        <div class="hero-overlay"></div>

        <div class="hero-content container">
            <div class="hero-subtitle">
                Adventure Starts Here
            </div>

            <h1 class="hero-title">
                @Constants.CompanyName
            </h1>

            <p class="hero-description">
                Experience the Little Miami River with kayak adventures. From first-time paddlers to seasoned outdoor enthusiasts, we make it easy to spend an unforgettable day on the water.
            </p>

            <div class="hero-buttons">
                <button class="btn btn-outline-light custom-btn" @onclick=@(() => NavMan.NavigateTo("#visit"))>
                    Visit Us
                </button>
            </div>
        </div>
    </section>

    <!-- THE SPACE -->
    <section class="section-padding" id="space">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="section-label">
                        THE EXPERIENCE
                    </div>

                    <h2 class="section-title">
                        More than a rental. A day on the river.
                    </h2>

                    <p class="section-text">
                        Paddle through one of Ohio's most scenic river corridors, pass the famous Loveland Castle, and enjoy a relaxing outdoor adventure just minutes from Cincinnati. Transportation, equipment, and local expertise are all included.
                    </p>

                    <div class="feature-row">
                        <div>
                            <div class="feature-number">
                                5 Miles
                            </div>

                            <div class="feature-text">
                                Castle Adventure
                            </div>
                        </div>

                        <div>
                            <div class="feature-number">
                                Daily
                            </div>

                            <div class="feature-text">
                                Trips Available
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="gallery-grid">
                        <img src="https://lovelandpaddlesports.com/wp-content/uploads/2022/07/home-hero-1.jpg"
                             class="gallery-img tall" />

                        <img src="https://lovelandpaddlesports.com/wp-content/uploads/2022/07/home-shop-1.jpg"
                             class="gallery-img tall offset-img" />

                        <img src="https://lovelandpaddlesports.com/wp-content/uploads/2022/07/castle-hero-1.jpeg"
                             class="gallery-img wide" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURED ADVENTURES -->
    <section class="menu-section section-padding" id="menu">
        <div class="container">

            <div class="text-center mb-5">
                <div class="section-label">
                    FEATURED ADVENTURES
                </div>

                <h2 class="section-title">
                    Choose your river experience.
                </h2>
            </div>

            <RentalBlocks />
        </div>
    </section>

    <!-- VISIT -->
    <section class="section-padding" id="visit">
        <div class="container">
            <div class="row g-5 align-items-center">

                <div class="col-lg-6">
                    <div class="section-label">
                        VISIT US
                    </div>

                    <h2 class="section-title">
                        Start your adventure in Loveland.
                    </h2>

                    <div class="visit-block">
                        <hr style="width:100%;opacity:1;background-color:@Accent" />
                        <h3>Hours</h3>

                        <h4 style="text-align:center">
                            @if (Constants.CompanyHours.Values.All(v => v.Equals(Constants.CompanyHours.Values.First())))
                            {
                                @("Daily: " + Constants.CompanyHours.Values.First())

                                <br />
                                <span>
                                    (Last trip departs at 3:00PM)
                                </span>

                            }
                            else
                            {
                                @foreach (var key in Constants.CompanyHours.Keys)
                                {
                                    @(key + ": " + Constants.CompanyHours[key])

                                    <br />
                                }
                            }
                        </h4>

                        <h4 class="section-label" style="text-align:center">
                            Note: Operations are subject to weather and river conditions permitting.
                            <br />
                            <br />
                            Please call 513-683-4611 or check our <a href="https://www.facebook.com/LovelandCanoe" style="color:orange;text-decoration:underline">Facebook page</a> for current status.
                        </h4>
                    </div>
                    <hr style="width:100%;opacity:1;background-color:@Accent" />

                    <div class="visit-block">
                        <h3>Location</h3>


                        <h4>
                            Loveland, Ohio<br />
                            Free parking, easy access nearby
                        </h4>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="map-placeholder">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3088.9603346662743!2d-84.26279232404536!3d39.266466571647655!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8840f8adece5d769%3A0xbce75d716f01c53!2sLoveland%20Paddlesports!5e0!3m2!1sen!2sus!4v1780338715773!5m2!1sen!2sus"
                                class="map-iframe" style="height:100%;width:100%;border-radius: 2rem;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SOCIAL -->
    <section class="social-section">
        <div class="container text-center">

            <div class="flex-r-100">
                <div class="section-label social-label">
                    FOLLOW ALONG
                </div>
            </div>

            <h2 class="social-title">
                @@lovelandcanoe
            </h2>

            <p class="social-text">
                River conditions, customer adventures, special events, kayak inventory updates, and photos from the Little Miami River.
            </p>

            <div class="flex-r-100-wrap">
                @foreach (string key in Constants.CompanySocials.Keys)
                {
                    <button class="btn custom-btn social-btn" @onclick=@(() => NavMan.NavigateTo(Constants.CompanySocials[key]))>
                        Visit @key
                    </button>
                }
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter(Name = "Main")]
    public string Main { get; set; }

    [CascadingParameter(Name = "Accent")]
    public string Accent { get; set; }

    [CascadingParameter(Name = "Text")]
    public string Text { get; set; }

    [CascadingParameter(Name = "ButtonText")]
    public string ButtonText { get; set; }

    protected override Task OnInitializedAsync()
    {
        Constants.CurPage = "Home";
        return base.OnInitializedAsync();
    }

    public class DrinkItem
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string ImgSrc { get; set; } = "";
    }
}