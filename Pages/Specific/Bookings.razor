@page "/booking"

@inject NavigationManager NavMan
@using StubSite.Data.Booking
@using StubSite.Shared
@using StubSite.Shared.Booking
@using StubSite.Shared.Specific
@using static StubSite.Shared.Specific.CustomTimeSlot

<BookingWidget @ref="bookingWidget" Title="Book a Yoga Session"
               Slots="@AvailableSlots"
               Options="@Options" />

@code {
    List<BookingSlot> AvailableSlots = new();
    private BookingWidget bookingWidget;

    BookingOptions Options = new BookingOptions
    {
        AccentColor = "#EAF3EA",
        ShowAvailabilityCount = true,
        ShowSessions = true
    };

    protected override void OnInitialized()
    {
        Constants.CurPage = "Reservations";

        var uri = new Uri(NavMan.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        try
        {
            // SelectedProduct = query["subject"];
        }
        catch (Exception e)
        {

        }

        // Generate time slots
        for (int i = 0; i < 7; i++)
        {
            AvailableSlots.Add(new BookingSlot
            {
                Date = DateTime.Today.AddDays(i), // Distribute across days
                Times = new List<BookingTime>()
            });

            Random random = new Random();

            bool IsFriday = AvailableSlots[i].Date.DayOfWeek == DayOfWeek.Friday;
            bool IsSaturday = AvailableSlots[i].Date.DayOfWeek == DayOfWeek.Saturday;

            if (IsFriday || IsSaturday)
            {
                AvailableSlots[i].Times.Add(new BookingTime
                {
                    StartTime = new TimeOnly(IsFriday ? 6 : 8, 0),
                    EndTime = new TimeOnly(IsFriday ? 7 : 9, 0),
                    Sessions = new List<BookingSession>
                        {
                            new BookingSession
                            {
                                Title = "Sunrise Vinyasa",
                                Description = "Start your day with a refreshing yoga session.",
                                Location = "Bloom Yoga Loft",
                                LocationURL = "https://maps.app.goo.gl/Px8euEmmX7xwBMaw6",
                                TotalSpots = 5,
                                TakenSpots = random.Next(0, 6),
                                Cost = 14
                            }
                        }
                });
            }

            if(i == 0)
            {
                AvailableSlots[i].Times.Add(new BookingTime
                {
                    StartTime = new TimeOnly(12, 0),
                    EndTime = new TimeOnly(13, 0),
                    Sessions = new List<BookingSession>
                        {
                            new BookingSession
                            {
                                Title = "Midday Stretch",
                                Description = "Take a break and rejuvenate with a midday yoga session.",
                                Location = "Loveland Paddlesports",
                                TotalSpots = 3,
                                TakenSpots = random.Next(0, 3),
                                Cost = 20
                            }
                        }
                });
            }
        }

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await bookingWidget.SelectDate(AvailableSlots[0].Date);
            StateHasChanged();
        }
    }
}
