@page "/order-status"
@using StubSite.StoreItems.Data
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime jsRuntime

<StoreStyle />

<div style="padding-left:1em">
    <h2 style="color:var(--main-text-color)">Order Status ⏲️</h2>
    @if (loading)
    {
        <p style="color:var(--main-text-color)">Loading your order details...</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            <strong>Something went wrong:</strong> @error
        </div>
    }
    else if (ThisOrder == null || string.IsNullOrEmpty(ThisOrder.Status))
    {
        <h3>No order found</h3>
    }
    else
    {
        <h3>Your order is being processed.</h3>

        <div class="switch-flex-space">
            <div class="store-flex-r">
                <h4><strong>Order Number:</strong></h4>
                <h4 class="text-primary">&nbsp;@ThisOrder.OrderNumber</h4>
            </div>

            <div class="store-flex-r">
                <h4><strong>Status:</strong></h4>
                <h4 class="text-primary">&nbsp;@ThisOrder.Status</h4>
            </div>

            <div class="store-flex-r">
                <h4><strong>Estimated Delivery:</strong></h4>
                <h4 class="text-primary">&nbsp;@ThisOrder.CreatedAt.AddDays(10).ToString("dddd - MMM dd, yyyy")</h4>
            </div>
        </div>
        <div class="store-flex-r-100-se" style="padding:1em">
            <div class="store-progress-bar" style="height:2em;background-color:purple;width:@LoadPercentage%;position:absolute;left:1em;" />
            <div class="store-flex-c store-status-blob@(LoadPercentage > 19 ? "-filled" : "")">Ordered</div>
            <div class="store-flex-c store-status-blob@(LoadPercentage > 39 ? "-filled" : "")">Built</div>
            <div class="store-flex-c store-status-blob@(LoadPercentage > 59 ? "-filled" : "")">Shipped</div>
            <div class="store-flex-c store-status-blob@(LoadPercentage > 79 ? "-filled" : "")">Delivered</div>
        </div>

        <hr />

        @if (ThisOrder.Items != null && ThisOrder.Items.Count > 0)
        {
            <h4 style="margin-top:30px;">Order Info</h4>

            <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                    <th style="text-align:center;text-decoration:underline">Product</th>
                    <th style="text-align:center;text-decoration:underline">Qty</th>
                    <th style="text-align:center;text-decoration:underline">Price</th>
                </tr>

                @foreach (var item in ThisOrder.Items)
                {
                    if (!item.Id.EndsWith("-Discounts") && !item.Id.EndsWith("-Taxes"))
                    {
                        <tr>
                            <td style="text-align:center;">@item.Name</td>
                            <td style="text-align:center;">@item.Quantity</td>
                            <td style="text-align:center;">@item.Cost</td>
                        </tr>
                    }
                }

                <tr style="border:1px solid white">
                    
                </tr>
                <tr>
                    <td></td>
                    <td style="text-align:center;"><strong>Subtotal:</strong></td>
                    <td style="text-align:center;"><strong>@Subtotal</strong></td>
                </tr>

                @if (Discounts != null)
                {
                    <tr>
                        <td></td>
                        <td style="text-align:center;"><strong>Discounts:</strong></td>
                        <td style="text-align:center;"><strong>(-@Discounts.Cost)</strong></td>
                    </tr>
                }

                @if (Taxes != null)
                {
                    <tr>
                        <td></td>
                        <td style="text-align:center;"><strong>Taxes:</strong></td>
                        <td style="text-align:center;"><strong>@Taxes.Cost</strong></td>
                    </tr>
                }

                <tr>
                    <td></td>
                    <td style="text-align:center;"><strong>Total:</strong></td>
                    <td style="text-align:center;"><strong>@ThisOrder.Total</strong></td>
                </tr>
            </table>

            <hr />
        }
    }
</div>

@code {
    private bool loading = true;
    private string error;

    int LoadPercentage;
    Order ThisOrder;

    OrderItem Discounts => ThisOrder != null && ThisOrder.Items != null ? ThisOrder.Items.FirstOrDefault(i => i.Id.EndsWith("-Discounts")) : null;
    OrderItem Taxes => ThisOrder != null && ThisOrder.Items != null ? ThisOrder.Items.FirstOrDefault(i => i.Id.EndsWith("-Taxes")) : null;
    decimal Subtotal => ThisOrder != null && ThisOrder.Items != null ? ThisOrder.Items.Sum(i => i.Id.EndsWith("-Discounts") ? 0 : i.Cost) : 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = new Uri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

            string OrderNumber = query["orderNumber"];
            if (!string.IsNullOrEmpty(OrderNumber))
            {
                var result = await StoreConstants.SendGetAPICallNoToken<StatusResponse>(Http, $"{StoreConstants.BaseUri}api/payments/order-status?OrderNumber={OrderNumber}");

                if (result != null && result.Success)
                {
                    ThisOrder = result.TheOrder;
                    LoadPercentage = LoadAmount();
                }
                else
                {
                    error = result?.Reason ?? "Unknown error occurred.";
                }
            }
            else
                error = "No order was set.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            StoreConstants.ClearCookieAsync(jsRuntime, "CART");
        return base.OnAfterRenderAsync(firstRender);
    }

    private int LoadAmount()
    {
        switch (ThisOrder.Status)
        {
            case "Ordered":
                return 20;
            case "Built":
                return 40;
            case "Shipped":
                return 60;
            case "Delivered":
                return 80;

        }
        return 0;
    }

    public class StatusResponse
    {
        public bool Success { get; set; }
        public string Reason { get; set; }
        public Order TheOrder { get; set; }
    }
}