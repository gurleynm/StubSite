@using StubSite.Data.Booking
<div class="times">

    @foreach (var slot in Slots)
    {

        <button class="time-card"
                disabled="@(!slot.IsAvailable)"
                style="--primary:@Options.PrimaryColor"
                @onclick="() => Select(slot)">


            <div class="time">
                @slot.StartTime
                -
                @slot.EndTime
            </div>


            @if (Options.ShowAvailabilityCount)
            {
                <div class="spots">
                    @slot.AvailableSpots spots left
                </div>
            }


            @if (Options.ShowSessions && slot.Sessions.Any())
            {

                <div class="sessions">

                    @foreach (var session in slot.Sessions)
                    {

                        <div class="session">

                            <h4>@session.Title</h4>


                            @if (Options.ShowSessionDescriptions)
                            {
                                <p>@session.Description</p>
                            }


                            @if (Options.ShowAvailabilityCount)
                            {
                                <small>
                                    @session.AvailableSpots available
                                </small>
                            }

                        </div>

                    }

                </div>

            }


        </button>

    }


</div>



@code {

    [Parameter]
    public List<BookingTime> Slots { get; set; } = new();


    [Parameter]
    public BookingOptions Options { get; set; } = new();


    [Parameter]
    public EventCallback<BookingTime> OnSelected { get; set; }



    async Task Select(BookingTime time)
    {
        await OnSelected.InvokeAsync(time);
    }

}