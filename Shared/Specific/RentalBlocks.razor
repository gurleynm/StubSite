@using StubSite.Data.Specific
<div class="flex-r-100-wrap">
    @* Trip Rental *@
    @foreach (PricingProduct prod in TripProds)
    {
        <PricingBlock Product="prod" Subject=@prod.Title/>
    }

    <PricingBlock Product="FivePack" Style="width:95%" ShowButton=false>
        <div class="flex-r-100" style="justify-content:space-evenly;padding:0% 5%;flex-wrap:wrap">
            @* Event Rental *@
            @foreach (PricingProduct prod in FivePackSubs)
            {
                <PricingBlock Product="prod" Subject=@(prod.Title) />
            }
        </div>
    </PricingBlock>
</div>

@code {
    PricingProduct FivePack = new PricingProduct()
        {
            Title = "5-Pack Special",
            Cost = "",
            Duration = "",
