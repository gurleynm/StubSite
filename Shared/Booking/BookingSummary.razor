@using StubSite.Data.Booking
@if (SelectedDate.HasValue && SelectedTime != null)
{
    <div class="booking-summary">
        <div class="position-absolute" style="right:.5em; top:.5em;cursor:pointer" @onclick=Clear><span class="oi oi-x" /></div>

        <div class="summary-info">

            <div>
                <small>Date</small>
                <strong>
                    @SelectedDate.Value.ToString("dddd, MMM d")
                </strong>
            </div>


            <div>
                <small>Time</small>
                <strong>
                    @SelectedTime.StartTime
                    -
                    @SelectedTime.EndTime
                </strong>
            </div>


            @if (SelectedSession != null)
            {
                <div>
                    <small>Session</small>
                    <strong>
                        @SelectedSession.Title
                    </strong>
                </div>

                <div>
                    <small>Cost</small>
                    <strong>
                            @SelectedSession.Cost.ToString("C")
                    </strong>
                </div>
            }
        </div>


        <button class="continue-button"
                style="--primary:@Options.PrimaryColor"
                @onclick="Continue">

            Continue

        </button>

    </div>
}


@code {

    [Parameter]
    public DateTime? SelectedDate { get; set; }


    [Parameter]
    public BookingTime? SelectedTime { get; set; }


    [Parameter]
    public BookingSession? SelectedSession { get; set; }


    [Parameter]
    public BookingOptions Options { get; set; } = new();


    [Parameter]
    public EventCallback OnContinue { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }


    async Task Continue()
    {
        await OnContinue.InvokeAsync();
    }

    async Task Clear()
    {
        await OnClear.InvokeAsync();
    }
}