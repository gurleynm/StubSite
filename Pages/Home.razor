@page "/"
@using StubSite.Shared.Specific
@inject NavigationManager NavMan

<PageTitle>Loveland Paddlesports</PageTitle>

<div style="overflow-x: hidden;">
    <!-- HERO -->
    <section class="hero-section"
             style="background-image:url('/images/Background.png')">

        <div class="hero-overlay"></div>

        <div class="hero-content container">
            <div class="hero-subtitle">
                Adventure Starts Here
            </div>

            <h1 class="hero-title">
                @Constants.CompanyName
            </h1>

            <p class="hero-description">
                Discover the comfort and freedom of recumbent bikes, trikes, and specialty cycling with a shop that helps you find the perfect fit.
            </p>

            <div class="hero-buttons">
                <button class="btn btn-outline-light custom-btn" @onclick=@(() => NavMan.NavigateTo("#visit"))>
                    Visit Us
                </button>
            </div>
        </div>
    </section>

    <!-- THE SPACE -->
    <section class="section-padding" id="space">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="section-label">
                        THE EXPERIENCE
                    </div>

                    <h2 class="section-title">
                        Ride Differently. A bike built around you.
                    </h2>

                    <p class="section-text">
                        Fairfield Cyclery specializes in helping riders discover a better cycling experience. Whether you want a relaxed neighborhood ride, long-distance adventure, or a stable three-wheel design, we help match you with the right ride.
                    </p>

                    <div class="feature-row">
                        <div>
                            <div class="feature-number">
                                Comfort First
                            </div>

                            <div class="feature-text">
                                Reclined seating position
                            </div>
                        </div>

                        <div>
                            <div class="feature-number">
                                More Confidence
                            </div>

                            <div class="feature-text">
                                Stabler handling
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="gallery-grid">
                        <img src="/images/interior-1.jpg"
                             class="gallery-img tall" />

                        <img src="https://nebula.wsimg.com/4b2d6a14c502052b17e54ee8abfe9cae?AccessKeyId=22876B868D3CCEA2C3AA&disposition=0&alloworigin=1"
                             class="gallery-img tall offset-img" />

                        <img src="https://nebula.wsimg.com/acc4b00346f6dc4f579394874bda7910?AccessKeyId=22876B868D3CCEA2C3AA&disposition=0&alloworigin=1"
                             class="gallery-img wide" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURED ADVENTURES 
    <section class="menu-section section-padding" id="menu">
        <div class="container">

            <div class="text-center mb-5">
                <div class="section-label">
                    FEATURED ADVENTURES
                </div>

                <h2 class="section-title">
                    Choose your river experience.
                </h2>
            </div>

            <RentalBlocks />
        </div>
    </section>
    -->
    <!-- VISIT -->
    <section class="menu-section section-padding" id="visit">
        <div class="container">
            <div class="row g-5 align-items-center">

                <div class="col-lg-6">
                    <div class="section-label">
                        VISIT US
                    </div>

                    <h2 class="section-title">
                        Start your adventure in Fairfield.
                    </h2>

                    <div class="visit-block">
                        <hr style="width:100%;opacity:1;background-color:@Accent" />
                        <h3>Hours:</h3>

                        <h4 style="text-align:center">
                            Tuesday - Friday: 12:00 PM - 4:00 PM
                            <br />
                            Saturday - Monday: Closed
                        </h4>

                        <h4 class="section-label" style="text-align:center">
                            Note: Operations are subject to appointment scheduling.
                            <br />
                            <br />
                            Please call
                            <a href="tel:@Constants.CompanyPhone" style="color:black;text-decoration:underline">
                                <strong>
                                    @Constants.CompanyPhone
                                </strong>
                            </a>
                            or Book your Appointment online.
                        </h4>
                    </div>
                    <hr style="width:100%;opacity:1;background-color:@Accent" />

                    <div class="visit-block">
                        <h3>Location</h3>


                        <h4>
                            <span class="oi oi-map-marker" /> @Constants.CompanyAddress
                        </h4>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="map-placeholder">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3085.488502010213!2d-84.54080702404156!3d39.34517287163201!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x884048bc7a6cd4cd%3A0x23d37b5b3b537492!2sFairfield%20Cyclery!5e0!3m2!1sen!2sus!4v1781583697656!5m2!1sen!2sus"
                                class="map-iframe" style="height:100%;width:100%;border-radius: 2rem;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SOCIAL -->
    <section class="social-section">
        <div class="container text-center">

            <div class="flex-r-100">
                <div class="section-label social-label">
                    FOLLOW ALONG
                </div>
            </div>

            <h2 class="social-title">
                @@fairfieldcyclery
            </h2>

            <p class="social-text">
                River conditions, customer adventures, special events, kayak inventory updates, and photos from the Little Miami River.
            </p>

            <div class="flex-r-100-wrap">
                @foreach (string key in Constants.CompanySocials.Keys)
                {
                    <button class="custom-btn social-btn" @onclick=@(() => NavMan.NavigateTo(Constants.CompanySocials[key]))>
                        Visit @key
                    </button>
                }
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter(Name = "Main")]
    public string Main { get; set; }

    [CascadingParameter(Name = "Accent")]
    public string Accent { get; set; }

    [CascadingParameter(Name = "Text")]
    public string Text { get; set; }

    [CascadingParameter(Name = "ButtonText")]
    public string ButtonText { get; set; }

    protected override Task OnInitializedAsync()
    {
        Constants.CurPage = "Home";
        return base.OnInitializedAsync();
    }

    public class DrinkItem
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string ImgSrc { get; set; } = "";
    }
}