@using StubSite.Data.Booking
<div class="calendar">

    @foreach (var date in Dates)
    {
        <button class="day @(SelectedDate == date ? "selected" : "")"
                style="--primary:@Options.PrimaryColor"
                @onclick="() => Select(date)">

            <span>@date.ToString("ddd")</span>
            <strong>@date.ToString("MMM")</strong>
            <strong>@date.ToString("dd")</strong>

        </button>
    }

</div>



@code {

    [Parameter]
    public IEnumerable<DateTime> Dates { get; set; } = [];


    [Parameter]
    public DateTime? SelectedDate { get; set; } = DateTime.Now;


    [Parameter]
    public BookingOptions Options { get; set; } = new();


    [Parameter]
    public EventCallback<DateTime> OnDateSelected { get; set; }

    async Task Select(DateTime date)
    {
        await OnDateSelected.InvokeAsync(date);
    }

}