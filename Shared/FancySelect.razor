<div class="custom-select-wrapper" style="color:@Accent">
    <select class="custom-select" @bind="CurrentValue" style="border-color:black;background-color:white;color:@ButtonText;@Style">
        @ChildContent
    </select>
</div>

@code {
    [CascadingParameter(Name = "Main")]
    public string Main { get; set; }

    [CascadingParameter(Name = "Accent")]
    public string Accent { get; set; }

    [CascadingParameter(Name = "ButtonText")]
    public string ButtonText { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string Style { get; set; } = "margin:1em 0";

    public string valueLittle { get; set; }
    [Parameter]
    public string Value
    {
        get { return valueLittle; }
        set
        {
            CurrentValue = value;
        }
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private string CurrentValue
    {
        get => Value;
        set
        {
            if (Value == value)
                return;

            valueLittle = value;
            ValueChanged.InvokeAsync(value);
            StateHasChanged();
        }
    }
}
