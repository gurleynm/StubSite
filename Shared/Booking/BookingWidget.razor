@using StubSite.Data.Booking
<div class="booking-wrapper">

    @if (!string.IsNullOrEmpty(Title))
    {
        <h2>@Title</h2>
    }


    <BookingCalendar Dates="@AvailableDates"
                     SelectedDate="@SelectedDate"
                     OnDateSelected="SelectDate"
                     Options="@Options" />


    @if (SelectedDate.HasValue)
    {
        @if (SelectedSlots.Count == 0)
        {
            <div class="session-title">No Availability</div>
        }
        else
        {
            <BookingTimeSlots Slots="@SelectedSlots"
                              Options="@Options"
                              OnSelected="SelectTime" />
        }

        <BookingSummary SelectedDate="@SelectedDate"
                        SelectedTime="@SelectedTime"
                        SelectedSession="@SelectedSession"
                        Options="@Options"
                        OnClear="@CancelBooking"
                        OnContinue="@SubmitBooking" />
    }

</div>


@code {

    [Parameter]
    public string Title { get; set; } = "";


    [Parameter]
    public List<BookingSlot> Slots { get; set; } = new();


    [Parameter]
    public BookingOptions Options { get; set; } = new();


    [Parameter]
    public EventCallback<BookingTime> OnBookingSelected { get; set; }

    private BookingTime? SelectedTime;

    private BookingSession? SelectedSession;


    private DateTime? SelectedDate;


    private IEnumerable<DateTime> AvailableDates =>
        Slots.Select(x => x.Date);


    private List<BookingTime> SelectedSlots =>
        Slots.FirstOrDefault(x => x.Date == SelectedDate)
            ?.Times ?? new();


    private async Task SelectDate(DateTime date)
    {
        SelectedDate = date;
    }


    private async Task SelectTime(BookingTime time)
    {
        SelectedTime = time;
        if (SelectedTime.Sessions != null && SelectedTime.Sessions.Any(sess => sess.Selected))
        {
            // Auto-select first session for simplicity
            SelectedSession = SelectedTime.Sessions.First(sess => sess.Selected);
        }
        /*
            Future:

            Save booking
            Call API
            Reserve slot
            Handle payments
        */

        await OnBookingSelected.InvokeAsync(time);
    }
    private async Task SubmitBooking()
    {
        /*
            Future:

            await BookingService.CreateAsync(
                SelectedDate,
                SelectedTime,
                SelectedSession
            );
        */
    }
    private async Task CancelBooking()
    {
        foreach (var slot in SelectedSlots)
        {
            if (slot.Sessions != null)
            {
                foreach (var session in slot.Sessions)
                {
                    session.Selected = false;
                }
            }
        }

        SelectedTime = null;
        SelectedSession = null;

        /*
            Future:

            await BookingService.CreateAsync(
                SelectedDate,
                SelectedTime,
                SelectedSession
            );
        */
    }
}