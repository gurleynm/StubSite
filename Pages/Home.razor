@page "/"
@using StubSite.Shared.Specific

<HiveHero Image="/images/Background.jpg" />

<section class="hive-intro">
    <div style="padding:1em;background-color:wheat">
        <HiveSectionTitle Centered="false"
                          H2Color="black"
                          DescColor="dimgray"
                          Eyebrow="A LITTLE SOMETHING FOR EVERYONE"
                          Title="A little bit of everything good."
                          Description="One stop for your morning coffee and a little something unexpected." />
    </div>

    <div class="hive-feature-grid">
        <HiveFeatureCard Title="The Mercantile"
                         Category="THOUGHTFULLY CURATED"
                         Image="/images/mercantile.jpg"
                         Description="Discover local makers, unique gifts, and little treasures worth taking home."
                         Url="/mercantile"
                         LinkText="EXPLORE OUR FINDS" />
    </div>
</section>

<HiveDrinkShowcase />

<HiveMercantileShowcase />

<HiveVisitBanner />

@code {
    protected override void OnInitialized()
    {
        Constants.CurPage = "Home";
    }
}
