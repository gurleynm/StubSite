@page "/booking"

@inject NavigationManager NavMan
@using StubSite.Shared
@using StubSite.Shared.Specific
@using static StubSite.Shared.Specific.CustomTimeSlot

<div style="padding:1em">
    <div id="select-day" />
    <div class="flex-r-100">
        <StubSite.Shared.Specific.CustomCalendar @bind-SelectedDate="SelectedDate" />
    </div>

    <div id="select-time" />
    @if (SelectedDate != default)
    {
        <div class="fade-in-delay" style="padding:1em">
            <StubSite.Shared.Specific.CustomTimeSlot TimeSlots="availableSlots" OnSlotSelected="HandleSlotSelection" />
        </div>
    }
    @if (SelectedTime != default)
    {
        <BookingSummary SelectedDate=@SelectedDate SelectedTime=@SelectedTime OnClear=ClearTime />
    }
</div>

@code {
    string selectedProduct = "";
    string SelectedProduct
    {
        get { return selectedProduct; }
        set
        {
            if (selectedProduct == value)
                return;

            selectedProduct = value;
            Jump("select-day");
        }
    }

    TimeOnly SelectedTime { get; set; }

    DateTime selectedDate { get; set; }
    DateTime SelectedDate
    {
        get { return selectedDate; }
        set
        {
            if (selectedDate == value)
                return;

            selectedDate = value;
            SetAvailableSlots();

            Jump("select-time");
        }
    }

    protected override void OnInitialized()
    {
        Constants.CurPage = "Bookings";

        var uri = new Uri(NavMan.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        try
        {
            SelectedProduct = query["subject"];
        }
        catch (Exception e)
        {

        }

        SetAvailableSlots();

        base.OnInitialized();
    }

    private List<CustomTimeSlot.TimeSlot> availableSlots = new();
    private CustomTimeSlot.TimeSlot? selectedSlot;

    private void SetAvailableSlots()
    {
        availableSlots.Clear();

        // Generate time slots (e.g., 12 PM to 4 PM)
        Random random = new Random();
        for (int i = 12; i <= 16; i++)
        {
            availableSlots.Add(new TimeSlot
            {
                Time = new TimeSpan(i, 0, 0),
                IsAvailable = i != 14 // Something is unavailable
            });

            availableSlots.Add(new TimeSlot
            {
                Time = new TimeSpan(i, 30, 0),
                IsAvailable = random.Next(10) <= 6
            });
        }
    }

    private void ClearTime()
    {
        SelectedTime = default;
        StateHasChanged();
    }

    private async Task Jump(string id)
    {
        NavMan.NavigateTo(NavMan.Uri + "#" + id, forceLoad: false);
    }

    private void HandleSlotSelection(TimeSlot slot)
    {
        selectedSlot = slot;
        SelectedTime = TimeOnly.FromTimeSpan(slot.Time);
    }
}
