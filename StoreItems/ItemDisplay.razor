@using BlazorBootstrap
@using StubSite.StoreItems.Data
@using System.Collections.ObjectModel
@inject NavigationManager NavMan
@inject IJSRuntime JSRuntime

<div class="store-flex-c store-item-block" style="border: 2px solid silver;align-content:center">
    <div class="flex-c" style="height:10em;background-color:white;border-radius:2em;width:100%">
        @if (Loading)
        {
            <GTLoginComponents.Shared.GTSLoadingDots />
        }
        <Image Src="@Item.Images[0]" Style="border-radius:2em;cursor:pointer;max-height:10em" Alt="@(Item.Name + " Image")" @onclick=@(() => ViewDeats()) 
            @onload=@LoadedIn />
    </div>

    @* Name *@
    <h3 style="text-align:center;margin:1em 0">@Item.Name</h3>
    @* Description *@
    @* <p style="color:var(--main-subtle-text-color);text-align:center">@Item.Description</p> *@

    <button class="store-btn-primary" style="width:100%" @onclick=@(() => ViewDeats())>View Details</button>
    <hr style="width:100%" />
    <div class="store-flex-r-100-sb" style="flex-grow:1">
        <div class="store-flex-c" style="width:100%">
            <h4>Starting at:</h4>
            @if (!string.IsNullOrEmpty(AmountOffStr))
            {
                <p class="discount-tag">@AmountOffStr</p>
            }

            <div class="store-flex-r-100">
                @* Cost *@
                <h4>@StoreConstants.Pretty(DisplayCost)&nbsp;</h4>
                @if (!string.IsNullOrEmpty(AmountOffStr))
                {
                    <div style="text-decoration:line-through;">@StoreConstants.Pretty(Item.Cost)</div>
                }
            </div>
        </div>
    </div>
</div>

<Modal @ref=detailsModal HeaderCssClass="store-modal" BodyCssClass="store-modal">
    <HeaderTemplate>
        <h3>@Item.Name</h3>
    </HeaderTemplate>
    <BodyTemplate>
        <div class="store-flex-c">
            @* Image Carousel *@
            <Carousel @key=Item.Id ShowIndicators=@(Item.Images.Count > 1) ShowPreviousNextControls=@(Item.Images.Count > 1) Class="store-view-details-img">
                @for (int urlInd = 0; urlInd < Item.Images.Count; urlInd++)
                {
                    int localI = urlInd;
                    <CarouselItem Active="@(urlInd == 0)">
                        <Image Src="@Item.Images[localI]" Style="border-radius:2em;height:20em;width:20em" Alt="@(Item.Name + " Image")" />
                    </CarouselItem>
                }
            </Carousel>

            @* Description *@
            <p style="color:var(--main-subtle-text-color);text-align:center;margin-top:1em;">@Item.Description</p>

            <hr style="width:100%" />
            <div class="store-flex-r-100-sb" style="flex-grow:1">
                <div class="store-flex-c" style="width:100%">
                    <h4>Starting at:</h4>
                    @if (!string.IsNullOrEmpty(AmountOffStr))
                    {
                        <p class="discount-tag">@AmountOffStr</p>
                    }

                    <div class="store-flex-r-100">
                        @* Cost *@
                        <h4>@StoreConstants.Pretty(DisplayCost)&nbsp;</h4>
                        @if (!string.IsNullOrEmpty(AmountOffStr))
                        {
                            <div style="text-decoration:line-through;">@StoreConstants.Pretty(Item.Cost)</div>
                        }
                    </div>
                </div>
            </div>

            @* Add Button *@
            <div class="store-flex-r-100">
                <button class="store-btn-primary" @onclick=GoTo>
                    Contact Sales
                </button>
            </div>
            @if (Item.Quantity == StoreConstants.MaxQuantity)
            {
                <div class="store-flex-r-100 fade-in">
                    <span>
                        Max amount is @StoreConstants.MaxQuantity
                    </span>
                </div>
            }

            @if (Item.Quantity > 0)
            {
                <button class="store-btn-primary fade-in-delay" @onclick=GoTo>Go to Cart <span class="oi oi-cart" /></button>
            }
        </div>
    </BodyTemplate>
</Modal>

@code {
    Modal detailsModal;

    [Parameter]
    public SaleItem Item { get; set; }

    [Parameter]
    public Action QuantityChanged { get; set; }

    [CascadingParameter]
    public ObservableCollection<SaleItem> Items { get; set; } = new();

    decimal DisplayCost => Item.SalePercent == 0 ? Item.SaleAmount == 0 ? Item.Cost : Item.SaleAmount : Math.Round(Item.Cost * (1 - Item.SalePercent), 2);
    decimal AmountOff => Item.SalePercent == 0 ? Item.SaleAmount == 0 ? 0 : Item.Cost - Item.SaleAmount : Math.Round(Item.Cost * Item.SalePercent, 2);
    string AmountOffStr => Item.SalePercent == 0 ? Item.SaleAmount == 0 ? "" : "(" + StoreConstants.Pretty(AmountOff) + " Off)" : "(" + (100 * Item.SalePercent) + "% Off)";

    double X;

    bool Loading = true;

    protected override void OnInitialized()
    {
        if (Item.Quantity > 0)
            X = 100;

        base.OnInitialized();
    }

    void SlideLeft()
    {
        if (Item.Quantity == StoreConstants.MaxQuantity)
            return;

        Item.Quantity++;
        if (Item.Quantity == 1)
            X = 100;

        QuantityChanged();
    }

    void SlideRight()
    {
        Item.Quantity--;
        if (Item.Quantity == 0)
            X = 0;

        QuantityChanged();
    }

    private void ViewDeats()
    {
        detailsModal.ShowAsync();
        StateHasChanged();
    }

    private async void GoTo()
    {
        await JSRuntime.InvokeVoidAsync("ResetBodyOverflow");

        NavMan.NavigateTo("contact-us?subject=" + Item.Name + " Inquiry");
    }

    private void LoadedIn()
    {
        Loading = false;
        StateHasChanged();
    }
}
