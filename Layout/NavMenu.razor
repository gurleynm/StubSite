@using StubSite.Data
@using StubSite.Repo
@inject NavigationManager NavMan

@inject IJSRuntime JSRuntime
@implements IDisposable

<nav class="navbar navbar-expand-md top-bar fade-in border-while-open navbar-grow flex-c-start sticky-top" style="background-color:burlywood;">
    <div class="container-fluid">
        <a class="navbar-brand" style="margin-right:0;" href="">
            <img alt="Logo image" src="images/CompanyLogo.png" style="height:3em;border-radius:1em" />
        </a>

        <h2 class="navbar-toggler @NavButtonCssClass" style="transform:translateX(-.5em);border:none;font-size:xx-large;">@Constants.CurPage</h2>

        <ToggleMenu OnToggle="ToggleNavMenu" />
        <div class="collapse navbar-collapse fade-in-delay @NavBarCssClass" id="navbarCollapse" @onclick="ToggleNavMenu">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi" aria-hidden="true"></span> Home
                    </NavLink>
                </li>
                @* <li class="nav-item">
                    <NavLink class="nav-link" href="services">
                        <span class="oi oi-plus" aria-hidden="true"></span> Services
                    </NavLink>
                </li> *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="booking">
                        <span class="oi" aria-hidden="true"></span> Schedule
                    </NavLink>
                </li>

                @* Specific Start 
                <li class="nav-item">
                    <NavLink class="nav-link" href="shop">
                        <span class="oi" aria-hidden="true"></span> Shop
                    </NavLink>
                </li>
                *@

                @* Specific End *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="contact-me">
                        <span class="oi" aria-hidden="true"></span> Contact Me
                    </NavLink>
                </li>
            </ul>
            @if (!NoShowButtonPages.Any(page => NavMan.Uri.Trim('/').Contains(page)))
            {
                <button class="fade-in-delay btn btn-primary custom-btn hide-in-mobile" @onclick=GoToSchedule>
                    Book Your 🕑
                </button>
            }
        </div>

    </div>
    @if (!NoShowButtonPages.Any(page => NavMan.Uri.Trim('/').Contains(page)))
    {
        <button class="fade-in-delay btn btn-primary custom-btn hide-in-desktop" style="width:90%" @onclick=GoToSchedule>
            Book Your 🕑
        </button>
    }
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? NavBarCssClass => collapseNavMenu ? null : "show";
    private string? NavButtonCssClass => collapseNavMenu ? "collapsed" : null;

    string[] NoShowButtonPages = new string[] { "schedule", "contact-us", "booking" };

    List<string> Categories = new List<string>();

    string selCat { get; set; }
    string SelCat
    {
        get { return selCat; }
        set
        {
            if (string.IsNullOrEmpty(value))
                return;

            selCat = value;
            JumpToSection(selCat);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Constants.CurPageChanged += CurPageUpdated;

        Dictionary<string, List<Item>> Items = await MenuRepo.GetMenuItemsAsDictionary();
        Categories = Items.Keys.ToList();
    }
    private async void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    void GoToSchedule()
    {
        collapseNavMenu = true;
        NavMan.NavigateTo("/booking");
    }

    private void CurPageUpdated(object sender, string cp)
    {
        StateHasChanged();
    }

    private async Task JumpToSection(string id)
    {
        await JSRuntime.InvokeVoidAsync("scrollToFragment", id);
    }

    public void Dispose()
    {
        Constants.CurPageChanged -= CurPageUpdated;
    }
}
